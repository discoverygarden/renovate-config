{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "composer": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update _VERSION variables in Dockerfiles",
      "fileMatch": ["(^|/|\\.)Dockerfile$", "(^|/)Dockerfile\\.[^/]*$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z\\.-]+?)(?: depName=(?<depName>.+?))?(?: packageName=(?<packageName>.+?))?(?: extractVersion=(?<extractVersion>.+?))?(?: versioning=(?<versioning>.+?))?\n(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+)(?:\n(?:ENV|ARG) .+?_(?:DIGEST|COMMIT_HASH)=(?<currentDigest>.+))?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [".ddev/**"],
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "ddev images",
      "labels": [
        "no-update"
      ],
      "automerge" : true
    },
    {
      "matchFileNames": ["Dockerfile"],
      "matchRepositories": [
        "discoverygarden/dgi-starter",
        "discoverygarden/*-drupal"
      ],
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
          "231224489621.dkr.ecr.us-east-1.amazonaws.com/drupal-base"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "labels": [
        "patch"
      ],
      "automerge" : true
    },
    {
      "matchRepositories": [
        "discoverygarden/activemq-image",
        "discoverygarden/alpaca-image",
        "discoverygarden/crayfish-image",
        "discoverygarden/cantaloupe-image",
        "discoverygarden/drupal-base-image",
        "discoverygarden/drupal-base-dev-image",
        "discoverygarden/solr-image",
        "discoverygarden/solr-ctda-image"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "patch"
      ],
      "automerge" : true
    },
    {
      "matchRepositories": [
        "discoverygarden/activemq-image",
        "discoverygarden/alpaca-image",
        "discoverygarden/crayfish-image",
        "discoverygarden/cantaloupe-image",
        "discoverygarden/drupal-base-image",
        "discoverygarden/drupal-base-dev-image",
        "discoverygarden/solr-image",
        "discoverygarden/solr-ctda-image"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "minor"
      ],
      "automerge" : true
    },
    {
      "matchRepositories": [
        "discoverygarden/activemq-image",
        "discoverygarden/alpaca-image",
        "discoverygarden/crayfish-image",
        "discoverygarden/cantaloupe-image",
        "discoverygarden/drupal-base-image",
        "discoverygarden/drupal-base-dev-image",
        "discoverygarden/solr-image",
        "discoverygarden/solr-ctda-image"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "major"
      ],
      "automerge" : false
    },
    {
      "matchPackageNames": ["231224489621.dkr.ecr.us-east-1.amazonaws.com/*"],
      "versioning": "regex:^(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?(\\-(?<build>\\d+))?(-(?<compatibility>.*))?$"
    }
  ]
}
